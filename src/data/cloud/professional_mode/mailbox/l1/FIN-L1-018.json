    "steps": [
      {
        "id": "s1",
        "kind": "checklist",
        "instruction": "Open CloudWatch dashboards / metrics for payments-api.",
        "confirm_label": "Opened metrics"
      },
      {
        "id": "s2",
        "kind": "observe",
        "instruction": "Peak CPU % in sim?",
        "question": "Peak %?",
        "accept_keywords": [
          "72",
          "seventy"
